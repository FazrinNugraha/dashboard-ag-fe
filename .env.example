# Basis URL API backend (tanpa trailing slash).
# Development lokal:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Di production (Vercel), BIARKAN KOSONG agar default relatif "/api/v1" dipakai.
# Request akan diproksikan ke backend lewat vercel.json sehingga cookie sesi
# menjadi first-party (tidak diblokir Safari/iOS). Jangan isi dengan URL
# onrender.com langsung kecuali backend diset COOKIE_SAMESITE=none + SECURE=true.